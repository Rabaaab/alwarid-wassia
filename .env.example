# --- Option 1: cloud (Mistral API) ---
MISTRAL_API_KEY=YOUR_KEY_HERE
# MISTRAL_MODEL=mistral-small-latest

# --- Option 2: fully local LLM (no data leaves the machine), e.g. Ollama ---
# Install Ollama, then: ollama pull mistral   (or llama3.1, qwen2.5, ...)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=mistral

